# Razorpay test mode. Get these from Dashboard > Account & Settings > API Keys
# (make sure the dashboard toggle is on "Test Mode" — key id must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Powers three layers: CSV column mapping on ingest, the exception notes and
# month-end brief, and the ask agent on the dashboard. Without it, ingest uses the
# deterministic alias table, notes and the brief use templates, and the ask panel
# disables itself. Matching, metrics and the audit trail never need a key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional
PORT=8787
