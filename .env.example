# Razorpay test mode. Get these from Dashboard > Account & Settings > API Keys
# (make sure the dashboard toggle is on "Test Mode" — key id must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Exception explainer. Without this, Recon falls back to deterministic templates.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional
PORT=8787
