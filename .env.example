# Razorpay test mode. Get these from Dashboard > Account & Settings > API Keys
# (make sure the dashboard toggle is on "Test Mode" — key id must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Model provider. Set ANY ONE of the three below — that is all it takes.
#
# They power three layers: CSV column mapping on ingest, the exception notes and
# month-end brief, and the ask agent on the dashboard. Matching, metrics, the
# baseline comparison and the audit trail never call a model at all, so the
# reconciliation itself runs identically with no key whatsoever.
#
# They are tried in the order listed and the first one that answers wins. A
# provider that fails in a way a retry cannot fix — a bad key, an unfunded
# account, an unknown model — is dropped for the rest of the run and the next one
# takes over. A rate limit is treated as temporary, so a free tier that has run
# out for the minute falls through now and is used again later. Below all of them
# sit the deterministic templates, which need nothing and never fail.
# ---------------------------------------------------------------------------

# Paid. Best writing quality. Needs credit on the account.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Free, no card required — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free, no card required — https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Override when a default model name has moved on; the error message
# on an unknown model lists the ones your key can actually use.
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. Promotes one provider to the front of the chain without removing the
# others, so a demo can pin who answers first and still keep its fallbacks.
# LLM_PROVIDER=gemini

# Optional
PORT=8787
