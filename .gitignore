node_modules/
.env
.env.*
!.env.example
.DS_Store

# Run artefacts. These are regenerated by `npm run reconcile` / `explain` /
# `evaluate` and would otherwise churn on every run. The committed evidence for
# the numbers in the README lives in metrics/, which is versioned.
data/**/result.json
data/**/audit.jsonl
data/**/metrics.json

# Everything under data/ is generated — except the two fixed datasets below,
# which are committed on purpose so anyone can clone the repo and reproduce the
# published numbers without first having to trust that the generator is
# deterministic.
data/*
!data/.gitkeep
!data/demo/
!data/holdout/

# The comparison is a run artefact too — regenerated by `npm run compare`.
data/**/compare.json
